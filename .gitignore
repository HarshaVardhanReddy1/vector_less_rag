# Virtual environments
myenv/
.venv/
venv/
env/

# Environment files — commit .env.example, ignore everything else
.env
.env.*
!.env.example

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Generated project outputs — data is not source code
data/docs/
data/nodes/
data/pages/
data/tocs/
data/trees/
data/responses/

# Frontend build
frontend/node_modules/
frontend/dist/

# Log files
*.log
logs/

# Temporary / scratch files
*.tmp
*.bak

